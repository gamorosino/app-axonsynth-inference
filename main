#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.

set -e

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

# --nv is a no-op when no NVIDIA driver is present, so the same container
# runs GPU-accelerated or CPU-only inference (see the require_cuda config
# option to fail instead of silently falling back to CPU).
singularity exec -e --nv docker://gamorosino/app-axonsynth-inference:0.1 python3 main.py

[ -z "$(ls -A segmentation 2>/dev/null)" ] && echo "no output produced" && exit 1
exit 0
